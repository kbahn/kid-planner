<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="10dp"
    android:background="@drawable/widget_bg_light">

    <!-- 머리: 제목 · 완료 수 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1D1C1A" />
        <TextView
            android:id="@+id/w_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1D1C1A" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/w_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress" />

    <!-- 지금 / 다음 -->
    <TextView
        android:id="@+id/w_now"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="13sp"
        android:textColor="#55534E" />

    <!-- 할 일 목록: 상태 이모지 | 시간 | 일정 | 체크 시각 -->
    <LinearLayout
        android:id="@+id/w_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/w_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/w_row1_icon"
                android:layout_width="24dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/w_row1_time"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFeatureSettings="tnum"
                android:textSize="13sp"
                android:textColor="#8D8A83" />
            <TextView
                android:id="@+id/w_row1_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="14sp"
                android:textColor="#1D1C1A" />
            <TextView
                android:id="@+id/w_row1_at"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:fontFeatureSettings="tnum"
                android:textSize="12sp"
                android:textColor="#8D8A83" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/w_row2_icon"
                android:layout_width="24dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/w_row2_time"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFeatureSettings="tnum"
                android:textSize="13sp"
                android:textColor="#8D8A83" />
            <TextView
                android:id="@+id/w_row2_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="14sp"
                android:textColor="#1D1C1A" />
            <TextView
                android:id="@+id/w_row2_at"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:fontFeatureSettings="tnum"
                android:textSize="12sp"
                android:textColor="#8D8A83" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/w_row3_icon"
                android:layout_width="24dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/w_row3_time"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFeatureSettings="tnum"
                android:textSize="13sp"
                android:textColor="#8D8A83" />
            <TextView
                android:id="@+id/w_row3_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="14sp"
                android:textColor="#1D1C1A" />
            <TextView
                android:id="@+id/w_row3_at"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:fontFeatureSettings="tnum"
                android:textSize="12sp"
                android:textColor="#8D8A83" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_row4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/w_row4_icon"
                android:layout_width="24dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/w_row4_time"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFeatureSettings="tnum"
                android:textSize="13sp"
                android:textColor="#8D8A83" />
            <TextView
                android:id="@+id/w_row4_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="14sp"
                android:textColor="#1D1C1A" />
            <TextView
                android:id="@+id/w_row4_at"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:fontFeatureSettings="tnum"
                android:textSize="12sp"
                android:textColor="#8D8A83" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_row5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/w_row5_icon"
                android:layout_width="24dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/w_row5_time"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFeatureSettings="tnum"
                android:textSize="13sp"
                android:textColor="#8D8A83" />
            <TextView
                android:id="@+id/w_row5_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="14sp"
                android:textColor="#1D1C1A" />
            <TextView
                android:id="@+id/w_row5_at"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:fontFeatureSettings="tnum"
                android:textSize="12sp"
                android:textColor="#8D8A83" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_row6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/w_row6_icon"
                android:layout_width="24dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/w_row6_time"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFeatureSettings="tnum"
                android:textSize="13sp"
                android:textColor="#8D8A83" />
            <TextView
                android:id="@+id/w_row6_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="14sp"
                android:textColor="#1D1C1A" />
            <TextView
                android:id="@+id/w_row6_at"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:fontFeatureSettings="tnum"
                android:textSize="12sp"
                android:textColor="#8D8A83" />
        </LinearLayout>
    </LinearLayout>

    <!-- 꼬리: 업데이트 시각 · 새로고침 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/w_updated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:textColor="#8D8A83" />
        <TextView
            android:id="@+id/w_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="2dp"
            android:text="새로고침"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#2A78D6" />
    </LinearLayout>
</LinearLayout>
